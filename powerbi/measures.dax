// Scenario selection
VAR p = IF(NOT ISCROSSFILTERED(Products), "85123A", SELECTEDVALUE(Products[stock_code]))
VAR s = IF(NOT ISCROSSFILTERED(Scenarios), "R20-C55-S0", SELECTEDVALUE(Scenarios[scenario_key]))
RETURN IF(ISBLANK(p) || ISBLANK(s), "Choose one product and one complete scenario", p & " | " & s & " | modeled outcomes; not actual savings")

// Observed weekly units
SUM(WeeklySales[units])

// Replay weekly profit GBP
AVERAGE(ReplayWeekly[profit_proxy_gbp])

// Replay fill proxy
DIVIDE(SUM(ReplayWeekly[fulfilled_units]), SUM(ReplayWeekly[observed_sales]))

// Replay unmet proxy
SUM(ReplayWeekly[unmet_proxy_units])

// Replay tail GBP
AVERAGE(ReplaySummary[worst_5pct_profit_proxy_gbp])

// Replay average order
AVERAGE(ReplayWeekly[order])

// Raw source rows
MAX(CleaningAudit[rows])

// Removed sale lines
SUM(CleaningAudit[removed])

