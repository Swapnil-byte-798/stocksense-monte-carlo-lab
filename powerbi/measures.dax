// Selected order
VAR p = IF(NOT ISCROSSFILTERED(Products), "85123A", SELECTEDVALUE(Products[stock_code]))
VAR s = IF(NOT ISCROSSFILTERED(Scenarios), "R20-C55-S0", SELECTEDVALUE(Scenarios[scenario_key]))
RETURN IF(NOT ISBLANK(p) && NOT ISBLANK(s), CALCULATE(MAX(SimulationSummary[selected_order]), KEEPFILTERS(Products[stock_code]=p), KEEPFILTERS(Scenarios[scenario_key]=s)))

